body
{
	background-color: #111114;
	font-family: Roboto;
	color: #e2e2e8;
	margin: 0;
	padding: 0;
	width: 1024dp;
	height: 560dp;
	overflow: hidden;
}

/* ==========================================================================
   CHASSIS & MAIN CONTAINER
   ========================================================================== */

.g2_chassis
{
	display: flex;
	flex-direction: column;
	width: 1024dp;
	height: 560dp;
	background-color: #c41e24;
	border: 2dp #1a0406;
	box-sizing: border-box;
}

/* Chassis Top Lip with jack labels and brand bar */
.chassis_top_lip
{
	display: flex;
	flex-direction: column;
	background-color: #c41e24;
	border-bottom: 2dp #1a0406;
	padding: 4dp 14dp 6dp 14dp;
	box-sizing: border-box;
}

.jack_labels_row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 2dp 6dp 3dp 6dp;
	background-color: #8c1015;
	border-bottom: 1dp #1a0406;
	border-radius: 2dp;
}

.jack_lbl
{
	font-size: 7.5dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 0.8dp;
}

.top_brand_bar
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-top: 4dp;
}

.brand_title_group
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
}

.brand_title
{
	font-size: 16dp;
	font-weight: 900;
	color: #ffffff;
	letter-spacing: 3dp;
}

.brand_subtitle
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffcccc;
	letter-spacing: 1.5dp;
	margin-left: 2dp;
}

.brand_bar_right
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10dp;
}

.port_config_box
{
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: #1e2023;
	border: 1dp #121315;
	border-radius: 4dp;
	padding: 3dp 8dp;
	gap: 6dp;
}

.port_config_lbl
{
	font-size: 9dp;
	font-weight: 800;
	color: #a4a9b2;
	letter-spacing: 0.5dp;
}

.port_input_field
{
	width: 56dp;
	height: 18dp;
	line-height: 16dp;
	background-color: #121315;
	border: 1dp #383b40;
	border-radius: 3dp;
	color: #34d399;
	font-size: 10dp;
	font-weight: 700;
	text-align: center;
	padding: 0;
	box-sizing: border-box;
}

.port_input_field:focus
{
	border-color: #ff3838;
	background-color: #1e2023;
}

.btn_port_action
{
	display: inline-block;
	text-align: center;
	line-height: 16dp;
	height: 18dp;
	font-size: 9dp;
	font-weight: 800;
	letter-spacing: 0.5dp;
	color: #ffffff;
	background-color: #2b2d31;
	border: 1dp #383b40;
	border-radius: 3dp;
	padding: 0 6dp;
	cursor: pointer;
	box-sizing: border-box;
}

.btn_port_action:hover
{
	background-color: #c41e24;
	border-color: #ff3838;
	color: #ffffff;
}

.btn_port_action:active
{
	background-color: #8c1015;
	border-color: #1a0406;
}

/* Socket Status */
.socket_status
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4dp 10dp;
	border-radius: 4dp;
	background-color: #1e2023;
	border: 1dp #121315;
	gap: 10dp;
}

.socket_status:hover
{
	border-color: #383b40;
}

.socket_indicator
{
	display: inline-block;
	width: 6dp;
	height: 6dp;
	border-radius: 3dp;
	border: none;
	background-color: #666672;
	box-sizing: border-box;
}

.socket_details
{
	display: flex;
	flex-direction: column;
	gap: 1dp;
}

.socket_meta_row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
}

.socket_label
{
	font-size: 9dp;
	font-weight: 800;
	color: #a4a9b2;
	letter-spacing: 0.8dp;
}

.socket_badge
{
	font-size: 9dp;
	font-weight: 800;
	padding: 1.5dp 6dp;
	border-radius: 3dp;
	letter-spacing: 0.5dp;
}

.socket_status.socket_listening .socket_indicator
{
	background-color: #f59e0b;
	border: none;
}

.socket_status.socket_listening .socket_badge
{
	background-color: #3b2808;
	color: #fbbf24;
	border: 1dp #784c16;
}

.socket_status.socket_connected
{
	background-color: #1e2023;
	border-color: #166534;
}

.socket_status.socket_connected .socket_indicator
{
	background-color: #10b981;
	border: none;
}

.socket_status.socket_connected .socket_badge
{
	background-color: #062614;
	color: #4ade80;
	border: 1dp #166534;
}

.socket_status.socket_offline .socket_indicator
{
	background-color: #ef4444;
	border: none;
}

.socket_status.socket_offline .socket_badge
{
	background-color: #2b0c0e;
	color: #f87171;
	border: 1dp #7f1d1d;
}

.socket_text
{
	font-size: 9dp;
	font-weight: 600;
	color: #cbd0d6;
	letter-spacing: 0.3dp;
}

/* ==========================================================================
   RECESSED MAIN FACEPLATE
   ========================================================================== */

.panel_faceplate
{
	display: flex;
	flex-direction: row;
	background-color: #1e2023;
	border-top: 2dp #1a0406;
	border-bottom: 2dp #1a0406;
	padding: 8dp 10dp;
	gap: 8dp;
	height: 480dp;
	box-sizing: border-box;
}

.panel_console_divider
{
	width: 2dp;
	height: 100%;
	background-color: #121315;
	border-right: 1dp #383b40;
}

/* Common Section Containers */
.left_top_row,
.left_mid_row,
.left_bottom_row,
.param_lcds_row,
.encoders_cluster,
.variations_box,
.param_pages_column
{
	background-color: #2b2d31;
	border: 1dp #121315;
	border-radius: 4dp;
}

/* ==========================================================================
   LEFT CONSOLE: Performance & Utility
   ========================================================================== */

.left_console
{
	display: flex;
	flex-direction: column;
	width: 326dp;
	gap: 6dp;
	box-sizing: border-box;
}

.left_top_row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	padding: 6dp 8dp;
	box-sizing: border-box;
}

.knob_block
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.ctrl_label
{
	font-size: 9dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 0.5dp;
	text-align: center;
}

.sub_text_tiny
{
	font-size: 8dp;
	font-weight: 700;
	color: #a4a9b2;
	letter-spacing: 0.3dp;
	text-align: center;
}

.rotary_knob_frame
{
	width: 36dp;
	height: 36dp;
	display: flex;
	align-items: center;
	justify-content: center;
	drag: drag;
	cursor: ns-resize;
}

input.range.knob_slider
{
	width: 34dp;
	height: 18dp;
	drag: drag;
	cursor: ns-resize;
}

input.range.knob_slider slidertrack
{
	background-color: #121315;
	border: 1dp #383b40;
	border-radius: 2dp;
	height: 4dp;
}

input.range.knob_slider sliderbar
{
	width: 12dp;
	height: 14dp;
	background-color: #2b2d31;
	border: 1dp #383b40;
	border-radius: 2dp;
}

input.range.knob_slider sliderbar:hover
{
	background-color: #383b40;
	border-color: #555b63;
}

input.range.knob_slider sliderbar:active
{
	background-color: #121315;
	border-color: #121315;
}

input.range.knob_slider sliderarrowdec,
input.range.knob_slider sliderarrowinc
{
	display: none;
	width: 0;
	height: 0;
}

.knob_cap_static
{
	width: 26dp;
	height: 26dp;
	border-radius: 13dp;
	background-color: #1e2023;
	border: 2dp #121315;
}

.level_readout_tiny
{
	display: flex;
	flex-direction: column;
	align-items: center;
	font-size: 7dp;
	color: #ffffff;
	font-weight: 800;
}

.mic_meter_row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 2dp;
	margin-top: 1dp;
}

.meter_dot
{
	width: 5dp;
	height: 5dp;
	border-radius: 2.5dp;
	border: none;
	background-color: #301214;
	box-sizing: border-box;
}

.meter_tag
{
	font-size: 6dp;
	font-weight: 700;
	color: #a4a9b2;
}

.sys_store_cluster
{
	display: flex;
	flex-direction: row;
	gap: 5dp;
	align-items: flex-end;
}

.sys_btn_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.btn_with_led
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.disp_mode_cluster
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.rocker_switch_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.rocker_switch
{
	width: 50dp;
	height: 20dp;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 3dp;
	color: #e2e2e8;
	font-size: 7.5dp;
	font-weight: 800;
	cursor: pointer;
}

.rocker_switch:hover
{
	background-color: #34373c;
	border-color: #555b63;
	color: #ffffff;
}

.rocker_switch:active
{
	background-color: #121315;
	border-color: #121315;
}

/* ==========================================================================
   MAIN PATCH LCD
   ========================================================================== */

.main_lcd_container
{
	width: 100%;
	display: flex;
	justify-content: center;
	padding: 2dp 0;
}

.lcd_bezel
{
	background-color: #121315;
	border: 1dp #383b40;
	border-radius: 4dp;
	padding: 4dp;
	width: 300dp;
	box-sizing: border-box;
}

.lcd_screen
{
	background-color: #65a81e;
	border: 1dp #386b0e;
	border-radius: 2dp;
	padding: 5dp 10dp;
	box-sizing: border-box;
}

.main_lcd_screen
{
	height: 48dp;
	display: flex;
	flex-direction: column;
	justify-content: center;
	gap: 2dp;
}

.lcd_row
{
	font-family: DejaVu Sans Mono;
	font-size: 13dp;
	font-weight: 700;
	color: #061102;
	letter-spacing: 1.5dp;
}

/* ==========================================================================
   LEFT MID ROW: Navigator, Data Wheel, Keyboard Assign
   ========================================================================== */

.left_mid_row
{
	display: flex;
	flex-direction: row;
	gap: 8dp;
	padding: 6dp 8dp;
	box-sizing: border-box;
}

.wheel_nav_col
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
	width: 130dp;
}

.data_wheel_unit
{
	display: flex;
	align-items: center;
	justify-content: center;
}

.big_data_wheel
{
	width: 50dp;
	height: 50dp;
	border-radius: 25dp;
	background-color: #1e2023;
	border: 2dp #121315;
	display: flex;
	align-items: center;
	justify-content: center;
	drag: drag;
	cursor: ns-resize;
}

.big_data_wheel:hover
{
	border-color: #383b40;
	background-color: #2b2d31;
}

.wheel_dent
{
	width: 10dp;
	height: 10dp;
	border-radius: 5dp;
	background-color: #121315;
	border: 1dp #383b40;
	margin-left: -22dp;
	pointer-events: none;
}

.nav_cross_unit
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1dp;
}

.nav_mid_row
{
	display: flex;
	flex-direction: row;
	gap: 2dp;
}

.nav_btn
{
	width: 18dp;
	height: 14dp;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 2.5dp;
	color: #ffffff;
	font-size: 7dp;
	font-weight: 800;
	cursor: pointer;
	padding: 0;
	display: flex;
	align-items: center;
	justify-content: center;
}

.nav_btn:hover
{
	background-color: #34373c;
	border-color: #555b63;
}

.nav_btn:active
{
	background-color: #121315;
	border-color: #121315;
}

.patch_load_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

/* Keyboard Assign & Slots Box */
.kb_assign_box
{
	display: flex;
	flex-direction: column;
	width: 172dp;
	gap: 4dp;
}

.kb_assign_header
{
	border-bottom: 1dp #121315;
	padding-bottom: 2dp;
}

.section_caption
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 0.5dp;
}

.slots_flex_row
{
	display: flex;
	flex-direction: row;
	gap: 4dp;
	align-items: flex-end;
}

.slot_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.slot_btn_g2
{
	width: 25dp;
	height: 25dp;
	line-height: 23dp;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 3.5dp;
	color: #ffffff;
	font-size: 11dp;
	font-weight: 800;
	cursor: pointer;
	display: inline-block;
	text-align: center;
}

.slot_btn_g2:hover
{
	background-color: #34373c;
	border-color: #555b63;
}

.slot_btn_g2:active
{
	background-color: #121315;
	border-color: #121315;
}

.slot_btn_g2:checked
{
	background-color: #c41e24;
	border-color: #ff3838;
	color: #ffffff;
}

.split_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	margin-left: 2dp;
}

.kb_assign_footer
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-top: 2dp;
}

.active_slot_badge
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	background-color: #121315;
	padding: 1.5dp 6dp;
	border-radius: 3dp;
	border: 1dp #383b40;
}

/* ==========================================================================
   LEFT BOTTOM ROW: Octave, Panic, Shift, Pitch/Mod Wheel
   ========================================================================== */

.left_bottom_row
{
	display: flex;
	flex-direction: row;
	gap: 6dp;
	padding: 6dp 8dp;
	box-sizing: border-box;
	align-items: flex-start;
}

.octave_group
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	width: 62dp;
}

.octave_leds_row
{
	display: flex;
	flex-direction: row;
	gap: 4dp;
}

.octave_btns_row
{
	display: flex;
	flex-direction: row;
	gap: 3dp;
}

.btn_octave
{
	width: 26dp;
	height: 18dp;
	line-height: 16dp;
	font-size: 8dp;
	font-weight: 700;
	padding: 0;
	display: inline-block;
	text-align: center;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 2.5dp;
	color: #ffffff;
}

.btn_octave:hover
{
	background-color: #34373c;
	border-color: #555b63;
}

.btn_octave:active
{
	background-color: #121315;
	border-color: #121315;
}

.util_btn_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.shift_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.btn_shift
{
	width: 36dp;
	height: 22dp;
	line-height: 20dp;
	display: inline-block;
	text-align: center;
	font-size: 9.5dp;
	background-color: #dcdad2;
	border: 1dp #8e8c84;
	color: #121315;
	font-weight: 700;
	border-radius: 3dp;
	cursor: pointer;
}

.btn_shift:hover
{
	background-color: #eeece4;
	border-color: #aba89e;
	color: #000000;
}

.btn_shift:checked
{
	background-color: #f59e0b;
	border: 1dp #b45309;
	color: #000000;
}

.perf_controllers_box
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
	margin-left: 4dp;
}

.stick_wheel_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
}

.perf_label
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 0.5dp;
}

/* Clavia Wooden Pitch Stick Rocker */
.pitch_stick_slot
{
	position: relative;
	width: 46dp;
	height: 26dp;
	background-color: #121315;
	border: 1.5dp #1a0406;
	border-radius: 3dp;
	box-sizing: border-box;
}

input.range.perf_pitch_stick
{
	width: 43dp;
	height: 23dp;
	drag: drag;
	cursor: ew-resize;
}

input.range.perf_pitch_stick slidertrack
{
	height: 23dp;
	background-color: transparent;
	border: none;
}

input.range.perf_pitch_stick sliderbar
{
	width: 22dp;
	height: 21dp;
	margin-top: 1dp;
	decorator: vertical-gradient(#c68a4c #b87333);
	border: 1.5dp #7a4618;
	border-radius: 3dp;
}

input.range.perf_pitch_stick sliderbar:hover
{
	decorator: vertical-gradient(#d4995b #c68a4c);
	border-color: #92541e;
}

input.range.perf_pitch_stick sliderbar:active
{
	decorator: vertical-gradient(#aa6a2e #9c5e26);
	border-color: #5c3410;
}

input.range.perf_pitch_stick sliderarrowdec,
input.range.perf_pitch_stick sliderarrowinc
{
	display: none;
	width: 0;
	height: 0;
}

.pitch_center_notch
{
	position: absolute;
	left: 22dp;
	top: 3dp;
	width: 2dp;
	height: 17dp;
	background-color: #522d0c;
	border-left: 0.5dp #381e08;
	border-right: 0.5dp #8a5022;
	pointer-events: none;
}

/* Clavia Textured Stone Mod Wheel */
.mod_wheel_slot
{
	position: relative;
	width: 24dp;
	height: 38dp;
	background-color: #121315;
	border: 1.5dp #1a0406;
	border-radius: 3dp;
	box-sizing: border-box;
}

input.range.perf_mod_wheel
{
	width: 21dp;
	height: 35dp;
	drag: drag;
	cursor: ns-resize;
}

input.range.perf_mod_wheel slidertrack
{
	width: 21dp;
	height: 35dp;
	background-color: transparent;
	border: none;
}

input.range.perf_mod_wheel sliderbar
{
	width: 19dp;
	height: 16dp;
	margin-left: 1dp;
	decorator: vertical-gradient(#7c8085 #64686c);
	border: 1.5dp #3e4145;
	border-radius: 2.5dp;
}

input.range.perf_mod_wheel sliderbar:hover
{
	decorator: vertical-gradient(#8a8e94 #72767a);
	border-color: #52565c;
}

input.range.perf_mod_wheel sliderbar:active
{
	decorator: vertical-gradient(#5a5e62 #4e5256);
	border-color: #2b2e32;
}

input.range.perf_mod_wheel sliderarrowdec,
input.range.perf_mod_wheel sliderarrowinc
{
	display: none;
	width: 0;
	height: 0;
}

.mod_wheel_groove
{
	position: absolute;
	left: 4dp;
	top: 17dp;
	width: 14dp;
	height: 3dp;
	background-color: #222426;
	border-top: 1dp #121315;
	border-bottom: 1dp #505458;
	border-radius: 1.5dp;
	pointer-events: none;
}

.comm_leds_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1dp;
}

.comm_led
{
	width: 5dp;
	height: 5dp;
	border-radius: 2.5dp;
	border: none;
	box-sizing: border-box;
}

.comm_led.lit
{
	background-color: #22c55e;
	border: none;
}

.comm_led.unlit
{
	background-color: #0c2414;
	border: none;
}

.comm_lbl
{
	font-size: 7dp;
	font-weight: 700;
	color: #a4a9b2;
}

/* ==========================================================================
   RIGHT CONSOLE: Parameter LCDs, 8 Encoders, Variations, Pages
   ========================================================================== */

.right_console
{
	display: flex;
	flex-direction: column;
	width: 662dp;
	gap: 4dp;
	box-sizing: border-box;
}

.param_header_row
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 0 4dp;
	width: 600dp;
}

.param_col_hdr
{
	width: 140dp;
	text-align: center;
}

.col_hdr_text
{
	font-size: 9.5dp;
	font-weight: 700;
	color: #ffffff;
	letter-spacing: 0.5dp;
}

/* Parameter LCDs Row */
.param_lcds_row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
	padding: 4dp 6dp;
	box-sizing: border-box;
}

.param_lcd_frame
{
	background-color: #121315;
	border: 1dp #383b40;
	border-radius: 4dp;
	padding: 3dp;
	width: 138dp;
	box-sizing: border-box;
}

.param_lcd_screen
{
	background-color: #65a81e;
	border: 1dp #386b0e;
	border-radius: 2dp;
	height: 38dp;
	display: flex;
	flex-direction: row;
	padding: 2dp 6dp;
	box-sizing: border-box;
}

.param_lcd_subcol
{
	display: flex;
	flex-direction: column;
	justify-content: center;
	width: 61dp;
}

.param_lcd_vert_split
{
	width: 1dp;
	height: 100%;
	background-color: #386b0e;
	border-right: 1dp #76c024;
	margin: 0 2dp;
}

.param_name
{
	font-family: DejaVu Sans Mono;
	font-size: 9dp;
	font-weight: 700;
	color: #0c1c04;
	letter-spacing: 0.5dp;
}

.param_data
{
	font-family: DejaVu Sans Mono;
	font-size: 11dp;
	font-weight: 700;
	color: #040c01;
	margin-top: 1dp;
	letter-spacing: 0.5dp;
}

.patch_settings_box
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	margin-left: 2dp;
}

/* ==========================================================================
   8 ROTARY ENCODERS WITH 15-LED CIRCULAR RINGS
   ========================================================================== */

.encoders_cluster
{
	display: flex;
	flex-direction: row;
	justify-content: flex-start;
	gap: 6dp;
	padding: 8dp 6dp;
	box-sizing: border-box;
	width: 602dp;
}

.encoder_pair_group
{
	display: flex;
	flex-direction: row;
	gap: 8dp;
	width: 140dp;
	justify-content: center;
}

.encoder_col
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4dp;
}

/* 15-LED Circular Ring Container (64dp x 64dp) */
.led_ring_container
{
	position: relative;
	width: 64dp;
	height: 64dp;
	drag: drag;
	cursor: ns-resize;
}

.ring_led
{
	position: absolute;
	width: 5dp;
	height: 5dp;
	border-radius: 2.5dp;
	border: none;
	box-sizing: border-box;
	pointer-events: none;
}

.ring_led.unlit
{
	background-color: #301214;
	border: none;
}

.ring_led.lit
{
	background-color: #ff3838;
	border: none;
}

/* Symmetric integer pixel coordinates around (32, 32), R=24dp */
.ring_led_0  { left: 13dp; top: 47dp; }
.ring_led_1  { left:  8dp; top: 40dp; }
.ring_led_2  { left:  6dp; top: 33dp; }
.ring_led_3  { left:  7dp; top: 25dp; }
.ring_led_4  { left: 10dp; top: 17dp; }
.ring_led_5  { left: 15dp; top: 11dp; }
.ring_led_6  { left: 22dp; top:  7dp; }
.ring_led_7  { left: 30dp; top:  6dp; }
.ring_led_8  { left: 38dp; top:  7dp; }
.ring_led_9  { left: 45dp; top: 11dp; }
.ring_led_10 { left: 50dp; top: 17dp; }
.ring_led_11 { left: 53dp; top: 25dp; }
.ring_led_12 { left: 54dp; top: 33dp; }
.ring_led_13 { left: 52dp; top: 40dp; }
.ring_led_14 { left: 47dp; top: 47dp; }

/* Central Anodized Tactile Rotor Knob */
.encoder_rotor
{
	position: absolute;
	left: 12dp;
	top: 12dp;
	width: 40dp;
	height: 40dp;
	border-radius: 20dp;
	background-color: #1e2023;
	border: 2dp #121315;
	display: flex;
	align-items: center;
	justify-content: center;
	pointer-events: none;
}

.knob_dial
{
	width: 28dp;
	height: 28dp;
	border-radius: 14dp;
	background-color: #2b2d31;
	border: 1dp #383b40;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	pointer-events: none;
}

.dial_dot
{
	width: 2dp;
	height: 6dp;
	background-color: #ffffff;
	border-radius: 1dp;
	margin-top: 2dp;
	pointer-events: none;
}

.btn_col_select
{
	width: 28dp;
	height: 16dp;
	line-height: 14dp;
	font-size: 9dp;
	font-weight: 700;
	padding: 0;
	display: inline-block;
	text-align: center;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 2.5dp;
	color: #e0e2e5;
}

.btn_col_select:hover
{
	background-color: #34373c;
	border-color: #555b63;
	color: #ffffff;
}

.btn_col_select:active
{
	background-color: #121315;
	border-color: #121315;
}

/* ==========================================================================
   RIGHT BOTTOM ROW: Variations + Parameter Pages
   ========================================================================== */

.right_bottom_row
{
	display: flex;
	flex-direction: row;
	gap: 8dp;
	box-sizing: border-box;
}

.variations_box
{
	display: flex;
	flex-direction: column;
	width: 530dp;
	padding: 5dp 8dp;
	box-sizing: border-box;
	gap: 4dp;
}

.variations_header
{
	border-bottom: 1dp #121315;
	padding-bottom: 2dp;
}

.variations_title
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 1.5dp;
}

.var_buttons_row
{
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	gap: 4dp;
}

.var_btn_item
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	width: 36dp;
}

.morph_btn_item
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	width: 44dp;
	margin-left: 4dp;
}

.morph_group_item
{
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2dp;
	width: 20dp;
}

.btn_var
{
	width: 32dp;
	height: 20dp;
	line-height: 18dp;
	font-size: 9dp;
	font-weight: 700;
	padding: 0;
	display: inline-block;
	text-align: center;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 3dp;
	color: #ffffff;
}

.btn_var:hover
{
	background-color: #34373c;
	border-color: #555b63;
	color: #ffffff;
}

.btn_var:active
{
	background-color: #121315;
	border-color: #121315;
}

.btn_small
{
	width: 18dp;
	height: 18dp;
	line-height: 16dp;
	font-size: 8.5dp;
	font-weight: 700;
	padding: 0;
	display: inline-block;
	text-align: center;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 2.5dp;
	color: #ffffff;
}

.btn_small:hover
{
	background-color: #34373c;
	border-color: #555b63;
}

.btn_small:active
{
	background-color: #121315;
	border-color: #121315;
}

.var_sub_tag
{
	font-size: 6dp;
	font-weight: 700;
	color: #a4a9b2;
	text-align: center;
	letter-spacing: 0.2dp;
}

/* Parameter Pages Column */
.param_pages_column
{
	display: flex;
	flex-direction: column;
	width: 120dp;
	padding: 5dp 8dp;
	box-sizing: border-box;
	gap: 4dp;
}

.pages_hdr_title
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 1dp;
	border-bottom: 1dp #121315;
	padding-bottom: 2dp;
}

.pages_list
{
	display: flex;
	flex-direction: column;
	gap: 3dp;
}

.page_btn_item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6dp;
}

.page_btn
{
	width: 22dp;
	height: 18dp;
	line-height: 16dp;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 2.5dp;
	color: #ffffff;
	font-size: 9dp;
	font-weight: 700;
	cursor: pointer;
	padding: 0;
	display: inline-block;
	text-align: center;
}

.page_btn:hover
{
	background-color: #34373c;
	border-color: #555b63;
}

.page_btn.checked,
.page_btn:checked
{
	background-color: #c41e24;
	border-color: #ff3838;
	color: #ffffff;
}

.page_btn:active
{
	background-color: #121315;
	border-color: #121315;
}

.page_name_lbl
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
}

/* ==========================================================================
   BUTTON & LED COMMON STYLES
   ========================================================================== */

.g2_btn
{
	display: inline-block;
	text-align: center;
	line-height: 18dp;
	background-color: #1e2023;
	border: 1dp #383b40;
	border-radius: 3dp;
	color: #e4e6ea;
	font-size: 9.5dp;
	font-weight: 700;
	cursor: pointer;
	box-sizing: border-box;
}

.g2_btn:hover
{
	background-color: #34373c;
	border-color: #555b63;
	color: #ffffff;
}

.g2_btn:active
{
	background-color: #121315;
	border-color: #121315;
}

.btn_dark
{
	width: 44dp;
	height: 20dp;
	line-height: 18dp;
}

.btn_red
{
	width: 44dp;
	height: 20dp;
	line-height: 18dp;
	background-color: #c41e24;
	border: 1dp #1a0406;
	color: #ffffff;
}

.btn_red:hover
{
	background-color: #d82329;
	border-color: #ff3838;
}

.btn_red:active
{
	background-color: #8c1015;
	border-color: #1a0406;
}

.btn_rect
{
	width: 38dp;
	height: 20dp;
	line-height: 18dp;
}

.btn_rect_narrow
{
	width: 34dp;
	height: 18dp;
	line-height: 16dp;
}

/* Red Panel LEDs */
.panel_led
{
	display: inline-block;
	width: 5dp;
	height: 5dp;
	border-radius: 2.5dp;
	border: none;
	box-sizing: border-box;
}

.panel_led.led_unlit,
.panel_led.slot_led_unlit,
.panel_led.unlit
{
	background-color: #301214;
	border: none;
}

.panel_led.led_lit,
.panel_led.slot_led_lit,
.panel_led.lit
{
	background-color: #ff3838;
	border: none;
}

/* ==========================================================================
   CHASSIS BOTTOM RIM
   ========================================================================== */

.chassis_bottom_lip
{
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	background-color: #c41e24;
	padding: 5dp 14dp;
	border-top: 2dp #1a0406;
	box-sizing: border-box;
}

.bottom_lip_left
{
	font-size: 8dp;
	font-weight: 700;
	color: #ffcccc;
	letter-spacing: 0.8dp;
}

.bottom_lip_right
{
	font-size: 8dp;
	font-weight: 800;
	color: #ffffff;
	letter-spacing: 1dp;
}

.btn_col_select.btn_col_active
{
	background-color: #c41e24;
	border-color: #ff3838;
	color: #ffffff;
}

.g2_btn.active_pulse,
.g2_btn.checked
{
	background-color: #c41e24;
	border-color: #ff3838;
	color: #ffffff;
}
