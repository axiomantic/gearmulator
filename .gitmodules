; Relative, so the URL follows whatever host the superproject was cloned from.
; The fork lives in a private Forgejo repository, and CI checks the superproject
; out over HTTPS with a token; a relative URL inherits those credentials, where
; an absolute SSH URL would need a key the CI container does not carry.
[submodule "source/cpu/dsp56300"]
	path = source/cpu/dsp56300
	url = ../dsp56300.git
[submodule "source/3rdparty/JUCE"]
	path = source/3rdparty/JUCE
	url = https://github.com/dsp56300/JUCE
[submodule "source/3rdparty/cpp-terminal"]
	path = source/3rdparty/cpp-terminal
	url = https://github.com/dsp56300/cpp-terminal
; Relative for the same reason as source/cpu/dsp56300 above: a private Forgejo
; fork reached with the superproject's own credentials rather than a key.
[submodule "source/cpu/mc68k"]
	path = source/cpu/mc68k
	url = ../mc68k.git
[submodule "source/3rdparty/clap-juce-extensions"]
	path = source/3rdparty/clap-juce-extensions
	url = https://github.com/dsp56300/clap-juce-extensions.git
[submodule "source/3rdparty/RmlUi"]
	path = source/3rdparty/RmlUi
	url = https://github.com/dsp56300/RmlUi.git
[submodule "source/3rdparty/freetype"]
	path = source/3rdparty/freetype
	url = https://github.com/freetype/freetype.git
[submodule "source/3rdparty/portmidi-latest"]
	path = source/3rdparty/portmidi-latest
	url = https://github.com/PortMidi/portmidi.git
[submodule "source/3rdparty/lunasvg"]
	path = source/3rdparty/lunasvg
	url = https://github.com/sammycage/lunasvg.git
